@model PillIdentifierMVC.Models.PillDetailModel
@{
    ViewBag.Title = Model.Thuoc != null ? Model.Thuoc.TenThuoc : "Chi Tiết Thuốc";
    var images   = Model.HinhAnhList ?? new List<ClassChung.HinhAnhThuocChiTiet>();
    var imgCount = images.Count;
}

<a href="@Url.Action("Index", "Home")" class="btn-back"
   onclick="if(window.history.length > 1 && document.referrer !== '') { window.history.back(); return false; }">← Quay
    lại kết quả</a>

<div class="detail-panel">

    <div class="detail-carousel">
        <div class="carousel-main">
            @if (imgCount > 0)
            {
                for (int i = 0; i < imgCount; i++)
                {
                    <div class="carousel-slide @(i == 0 ? "active" : "")">
                        <img src="@images[i].DuongDanHinh" alt="@Model.Thuoc.TenThuoc (@(i + 1))" @(i > 0 ? "loading=\"lazy\"" : "") />
                    </div>
                }
                if (imgCount > 1)
                {
                    <button class="carousel-btn prev" onclick="carouselMove(-1)">&#8249;</button>
                    <button class="carousel-btn next" onclick="carouselMove(1)">&#8250;</button>
                    <div class="carousel-counter"><span id="carouselCurrent">1</span>/@imgCount</div>
                }
            }
            else
            {
                <span class="carousel-placeholder-text">Chưa có<br />hình ảnh</span>
            }
        </div>
        @if (imgCount > 1)
        {
            <div class="carousel-thumbs-wrapper">
                <button class="thumb-scroll-btn" id="thumbScrollLeft" onclick="thumbScroll(-1)">&#8249;</button>
                <div class="carousel-thumbs" id="carouselThumbs" onscroll="updateThumbScrollBtns()">
                    @for (int i = 0; i < imgCount; i++)
                    {
                        <div class="carousel-thumb @(i == 0 ? "active" : "")" data-index="@i" onclick="carouselGoTo(@i)">
                            <img src="@images[i].DuongDanHinh" alt="@(i + 1)" />
                        </div>
                    }
                </div>
                <button class="thumb-scroll-btn" id="thumbScrollRight" onclick="thumbScroll(1)">&#8250;</button>
            </div>
            <script>
                (function () {
                    var idx = 0;
                    var total = @imgCount;

                    window.carouselMove = function (dir) {
                        carouselGoTo((idx + dir + total) % total);
                    };

                    window.carouselGoTo = function (i) {
                        var slides = document.querySelectorAll('.carousel-slide');
                        var thumbs = document.querySelectorAll('.carousel-thumb');
                        slides[idx].classList.remove('active');
                        thumbs[idx].classList.remove('active');
                        idx = i;
                        slides[idx].classList.add('active');
                        thumbs[idx].classList.add('active');
                        document.getElementById('carouselCurrent').textContent = idx + 1;
                        thumbs[idx].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
                        updateThumbScrollBtns();
                    };

                    window.thumbScroll = function (dir) {
                        document.getElementById('carouselThumbs').scrollLeft += dir * 110;
                        setTimeout(updateThumbScrollBtns, 300);
                    };

                    window.updateThumbScrollBtns = function () {
                        var el = document.getElementById('carouselThumbs');
                        var l  = document.getElementById('thumbScrollLeft');
                        var r  = document.getElementById('thumbScrollRight');
                        if (!el) return;
                        var overflows = el.scrollWidth > el.clientWidth;
                        l.style.display = overflows && el.scrollLeft > 0 ? 'flex' : 'none';
                        r.style.display = overflows && (el.scrollLeft + el.clientWidth < el.scrollWidth - 1) ? 'flex' : 'none';
                    };

                    document.addEventListener('DOMContentLoaded', updateThumbScrollBtns);
                })();
            </script>
        }
    </div>

    <div class="detail-drug-name">@Model.Thuoc.TenThuoc</div>

    <div class="detail-section-title">Thông tin chung</div>

    @if (!string.IsNullOrEmpty(Model.Thuoc.NhaSX))
    {
        <div class="detail-row">
            <div class="detail-label">Nhà sản xuất</div>
            <div class="detail-value">@Model.Thuoc.NhaSX</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.TenHoatChat))
    {
        <div class="detail-row">
            <div class="detail-label">Hoạt chất</div>
            <div class="detail-value">@Model.TenHoatChat</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Thuoc.HamLuong))
    {
        <div class="detail-row">
            <div class="detail-label">Hàm lượng</div>
            <div class="detail-value">@Model.Thuoc.HamLuong</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Thuoc.DangBaoChe))
    {
        <div class="detail-row">
            <div class="detail-label">Dạng bào chế</div>
            <div class="detail-value">@Model.Thuoc.DangBaoChe</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Thuoc.SDK))
    {
        <div class="detail-row">
            <div class="detail-label">Số đăng ký</div>
            <div class="detail-value">@Model.Thuoc.SDK</div>
        </div>
    }
    @if (Model.Thuoc.URL != null && !string.IsNullOrEmpty(Model.Thuoc.URL))
    {
        <div class="detail-row">
            <div class="detail-label">Hướng dẫn sử dụng</div>
            <div class="detail-value">
                <a href="@Model.Thuoc.URL"
                   target="_blank"
                   class="alert-link">@Model.Thuoc.TenThuoc</a>
            </div>
        </div>
    }

    <div class="detail-section-title">Nhận dạng vật lý</div>

    @if (Model.Mausac != null && Model.Mausac.Count > 0)
    {
        <div class="detail-row">
            <div class="detail-label">Màu sắc</div>
            <div class="detail-value">
                @foreach (var ms in Model.Mausac)
                {
                    <span class="color-tag">@ms.TenMauSac</span>
                }
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.TenHinhDang))
    {
        <div class="detail-row">
            <div class="detail-label">Hình dạng</div>
            <div class="detail-value">@Model.TenHinhDang</div>
        </div>
    }
    @if (Model.NhanDang != null && Model.NhanDang.KichThuoc > 0)
    {
        <div class="detail-row">
            <div class="detail-label">Đường kính</div>
            <div class="detail-value">@Model.NhanDang.KichThuoc mm</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.TenLoaiRanh))
    {
        <div class="detail-row">
            <div class="detail-label">Loại rãnh</div>
            <div class="detail-value">@Model.TenLoaiRanh</div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.TenLoaiVi))
    {
        <div class="detail-row">
            <div class="detail-label">Loại vỉ thuốc</div>
            <div class="detail-value">@Model.TenLoaiVi</div>
        </div>
    }
    @if (Model.NhanDang != null && !string.IsNullOrEmpty(Model.NhanDang.KhacDauMatTruoc))
    {
        <div class="detail-row">
            <div class="detail-label">Khắc dấu mặt trước</div>
            <div class="detail-value">@Model.NhanDang.KhacDauMatTruoc</div>
        </div>
    }
    @if (Model.NhanDang != null && !string.IsNullOrEmpty(Model.NhanDang.KhacDauMatSau))
    {
        <div class="detail-row">
            <div class="detail-label">Khắc dấu mặt sau</div>
            <div class="detail-value">@Model.NhanDang.KhacDauMatSau</div>
        </div>
    }
    @if (Model.NhanDang != null && !string.IsNullOrEmpty(Model.NhanDang.MaHinh))
    {
        <div class="detail-row">
            <div class="detail-label">Mã hình</div>
            <div class="detail-value">@Model.NhanDang.MaHinh</div>
        </div>
    }
    
</div>
